https://dbdiagram.io/d

table city{
  id integer [pk]
  name string
  district_id integer [ref: > district.id]
}

table district{
  id integer [pk]
  name string 
}

table carwash{
  id integer [pk]
  worker_id integer
  city_id integer [ref: > city.id]
  box_id integer
  service_id integer [ref: < service.id]
}

table client {
  id integer [pk]
  name string
}

table car{
  id integer [pk]
  name string
}

table worker {
  id integer [pk]
  name string
  carwash_id integer [ref: > carwash.id]
}

table box{
  id integer [pk]
  carwash_id integer [ref: > carwash.id]
}

table service{
  id integer [pk]
  name string
  description string
}

table slot{
  id integer [pk]
  date date
  time time
}

table order{
  id integer [pk]
  client_id integer [ref: - client.id]
  car_id integer [ref: - car.id]
  worker_id integer [ref: < worker.id]
  box_id integer [ref: - box.id]
  service_id integer [ref: < service.id]
  slot_id integer [ref: - slot.id]
}

table carwash_x_service{
  carwash_id integer [ref: - carwash.id]
  service_id integer [ref: - service.id]
}

table order_x_service{
  order_id integer [ref: - order.id]
  service_id integer [ref: - service.id]
}

table client_x_car{
  user_id integer [ref: - client.id]
  car_id integer [ref: - car.id]
}
